{
	"name": "@loremus299/pineapple",
	"version": "1.0.1",
	"description": "Typesafe side effects and error handling for Typescript.",
	"keywords": [
		"typescript"
	],
	"homepage": "https://github.com/Loremus299/pineapple#readme",
	"bugs": {
		"url": "https://github.com/Loremus299/pineapple/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Loremus299/pineapple.git"
	},
	"license": "MIT",
	"author": "Loremus",
	"scripts": {
		"generate": "tsdown"
	},
	"peerDependencies": {
		"drizzle-orm": "^1.0.0-rc.4"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"devDependencies": {
		"drizzle-orm": "^1.0.0-rc.4",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./drizzle/postgres": {
			"import": {
				"types": "./dist/drizzle/pg/index.d.mts",
				"default": "./dist/drizzle/pg/index.mjs"
			},
			"require": {
				"types": "./dist/drizzle/pg/index.d.cts",
				"default": "./dist/drizzle/pg/index.cjs"
			}
		}
	}
}
