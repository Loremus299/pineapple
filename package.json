{
  "name": "@loremus299/pineapple",
  "version": "1.0.0",
  "description": "OpenAPI 3.0.0 Typescript Generator with Zod.",
  "keywords": [
    "openapi",
    "zod"
  ],
  "homepage": "https://github.com/Loremus299/pineapple#readme",
  "bugs": {
    "url": "https://github.com/Loremus299/pineapple/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loremus299/pineapple.git"
  },
  "license": "MIT",
  "author": "Loremus",
  "scripts": {
    "generate": "tsdown"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
